# Copy to .env and fill in. Never commit .env.
# In GitHub, the same two values are repository secrets used by the morning fetch.

# https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=your_key_here

# https://app.balldontlie.io/
BALLDONTLIE_TOKEN=your_key_here

# Optional: TheSportsDB (Inter Miami / national teams). Defaults to the free key "123".
# THESPORTSDB_KEY=
